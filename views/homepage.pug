doctype html
html(lang="en")
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Custom Object Table
        a.nav-link(href="/update-cobj") Add to this table
        table
            thead
                tr
                    th Name
                    th Model
                    th Color
            tbody
                each car in data
                    tr
                        td #{car.properties.name}
                        td #{car.properties.model}
                        td #{car.properties.color}